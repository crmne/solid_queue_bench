#!/usr/bin/env ruby

require "csv"
require "fileutils"
require "json"
require "pathname"

csv_path = ARGV.fetch(0)
output_dir = if (index = ARGV.index("--output-dir"))
  ARGV.fetch(index + 1)
else
  File.dirname(csv_path)
end

rows = CSV.read(csv_path, headers: true).map do |row|
  row.to_h.transform_values do |value|
    next nil if value.nil? || value.empty?

    Float(value)
  rescue ArgumentError
    value
  end
end

basename = File.basename(csv_path, ".csv").sub(/-data\z/, "")
workload = basename
  .sub(/\A(?:matrix|sweep)-(?:solid-queue|async-job)-/, "")
  .sub(/-\d{8}-\d{6}\z/, "")
  .tr("-", "_")
family = File.basename(File.expand_path(output_dir))
family = rows.first&.fetch("backend", "solid_queue").to_s.tr("_", "-") unless %w[solid-queue async-job solid-queue-stress].include?(family)
json_path = File.join(output_dir, "#{workload.tr('_', '-')}-data.json")

data = {
  "workload" => workload,
  "results" => rows.map do |row|
    row.merge(
      "total_latency_ms" => {
        "p50" => row.delete("total_latency_p50_ms"),
        "p95" => row.delete("total_latency_p95_ms"),
        "p99" => row.delete("total_latency_p99_ms"),
        "max" => row.delete("total_latency_max_ms")
      }.compact
    )
  end
}

tmp_json = File.join(output_dir, ".#{File.basename(json_path)}")
File.write(tmp_json, JSON.pretty_generate(data))

require_relative "../lib/bench/report"

report = Bench::Report.new(File.expand_path("..", output_dir))
dataset = Bench::Report::Dataset.new(family:, json_path: tmp_json, data:)
report.send(:write_workload_charts, dataset)
FileUtils.rm_f(tmp_json)
